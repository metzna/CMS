# One website. This file belongs next to the customer's folder, e.g. at
# /srv/kunden/kunde-a/compose.yaml -- then run "docker compose up -d" there.
#
# Two services from the same image: the CMS and the login in front of it.
# Separate, because one container should run one program; the image is the
# same for both, so it takes no extra space.

name: kunde-a

services:
  cms:
    image: cms:0.131.0
    restart: unless-stopped
    # The program needs no special privileges: drop them all, and never gain
    # new ones, not even via setuid programs in the image.
    cap_drop: [ALL]
    security_opt: ["no-new-privileges:true"]
    # --git records every change as a commit, --push backs it up off-site.
    # For --push the container needs a deploy key: then also mount ~/.ssh
    # here as a read-only volume and set the remote in the clone.
    command: ["python3", "-u", "/opt/cms/server.py",
              "--host", "0.0.0.0", "--port", "8080",
              "--content", "/site/website/content",
              "--git", "--git-name", "CMS", "--git-email", "cms@kunde-a.de"]
    # IMPORTANT: 127.0.0.1 in front. Without it Docker exposes the port past
    # the firewall -- the port would be open to the internet, even with ufw
    # active.
    ports:
      - "127.0.0.1:8081:8080"
    volumes:
      # The content lives on the host. The container is disposable, this
      # folder is not: git goes here, the backup goes here.
      - ./site:/site
    healthcheck:
      test: ["CMD", "python3", "-c",
             "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/api/site').read()"]
      interval: 30s
      timeout: 5s
      retries: 3

  auth:
    image: cms:0.131.0
    restart: unless-stopped
    # The program needs no special privileges: drop them all, and never gain
    # new ones, not even via setuid programs in the image.
    cap_drop: [ALL]
    security_opt: ["no-new-privileges:true"]
    command: ["python3", "-u", "/opt/cms/auth.py",
              "--host", "0.0.0.0", "--port", "9000",
              "--config", "/auth/auth.toml"]
    ports:
      - "127.0.0.1:9001:9000"
    volumes:
      # Contains auth.toml and the auth.key created on first start.
      # Must be writable, otherwise the key can't be created.
      - ./auth:/auth
    healthcheck:
      test: ["CMD", "python3", "-c",
             "import socket; socket.create_connection(('127.0.0.1', 9000), 2).close()"]
      interval: 30s
      timeout: 5s
      retries: 3
