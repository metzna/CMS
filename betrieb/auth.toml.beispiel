# Access to this one website. Belongs next to the site, not in the repo --
# it contains a password hash.
#
# Generate the hash:
#     python3 cms/auth.py --hash-password
#
# The session key sits next to it in auth.key (created on first start,
# mode 0600). Deleting it invalidates every session -- that is how to log
# everyone out at once.

# REQUIRED. The UI runs under this address. Must match the Caddy block:
# if a request arrives with a different host, the service rejects it.
host = "cms.kunde-a.de"

# OPTIONAL. Heading of the login page. Default: host.
name = "Bäckerei Meier"

# REQUIRED. Exactly one account per website.
user     = "meier"
password = "scrypt$16384$8$1$…$…"
