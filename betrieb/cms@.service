# /etc/systemd/system/cms@.service   ->   systemctl enable --now cms@kunde-a
# One unit for all customers; %i is the customer ID.
[Unit]
Description=CMS for %i
After=network.target

[Service]
User=cms-%i
EnvironmentFile=/etc/cms/%i.env
ExecStart=/usr/bin/python3 -u /opt/cms/server.py --port ${PORT} --content ${CONTENT}
Restart=on-failure

# Even a bug in the CMS couldn't get out of the customer folder.
ProtectSystem=strict
ReadWritePaths=/srv/kunden/%i
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
