# Example for one website. One such block per website -- ideally generated
# by the deployment and included via "import kunden/*.caddy".
#
# It comes with a second block for the public site itself:
#
#     kunde-a.de {
#         root * /srv/kunden/kunde-a/site/website/public
#         file_server
#     }
#
# Caddy fetches the certificates itself, as long as the names point to the server.

cms.kunde-a.de {

    # Login: bypasses the guard, otherwise you'd never reach the form.
    # 9001 is the login service of THIS site -- a separate one per website.
    handle /login* {
        reverse_proxy 127.0.0.1:9001
    }
    handle /logout {
        reverse_proxy 127.0.0.1:9001
    }

    # Everything else only with a valid session. forward_auth asks /check
    # before every request; 200 lets through, 302 sends to the login.
    handle {
        forward_auth 127.0.0.1:9001 {
            uri /check
            header_up X-Forwarded-Host {host}
            header_up X-Forwarded-Uri {uri}
        }
        reverse_proxy 127.0.0.1:8081
    }

    encode zstd gzip
    log {
        output file /var/log/caddy/cms.kunde-a.log
    }
}
